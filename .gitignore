# Java / Maven
backend/target/
*.class

# Node / Angular
frontend/node_modules/
frontend/dist/
frontend/.angular/
frontend/out-tsc/

# IDE
.idea/
.vscode/
*.iml

# OS
Thumbs.db
.DS_Store

# Env (secrets) — keep .env.example tracked
*.local.env
.env

# Self-signed TLS material generated at deploy time
certs-tls/

# nginx conf generated from template by deploy-domain.sh (has real domain baked in)
nginx-domain.generated.conf

# Machine-specific exported CA bundle (keep the folder, not the certs)
frontend/certs/*.crt
backend/certs/*.crt

# Large Claude Design export (design source-of-truth kept outside git;
# the decoded reference lives in tools/prototype_design.html)
BBC_SMS_standalone*.html
