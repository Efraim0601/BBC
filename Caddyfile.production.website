# Point d'entrée public de production, site institutionnel inclus.
# Caddy obtient et renouvelle seul les certificats Let's Encrypt.
#
# Remplace Caddyfile.production une fois l'enregistrement DNS « app » créé.
# Tant que app.bbcomplex.com ne résout pas, garder Caddyfile.production.

# Site institutionnel (vitrine publique)
bbcomplex.com, www.bbcomplex.com {
    reverse_proxy website:80
}

# Application de gestion scolaire (espace parents, enseignants, administration)
app.bbcomplex.com {
    reverse_proxy frontend:80
}
